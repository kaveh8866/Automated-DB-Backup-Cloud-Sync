# =============================================================================
# Project 03 · Automated DB Backup & Cloud Sync — environment template
# =============================================================================
# Copy to `.env` (never committed), adjust, then:
#   docker compose --env-file .env -f docker/docker-compose.yml up -d --build
#
# Every value below is a placeholder. No real credential belongs in this file.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=your_db_password_here
# Published on loopback only; the runner reaches the database over the compose network.
POSTGRES_PORT=5432

# --- Backup schedule (see configs/backup/backup.conf) ------------------------
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=7
BACKUP_KEEP_MINIMUM=3

# --- Cloud sync --------------------------------------------------------------
# local = copy into the archive volume (offline/mock target)
# rclone = push to an S3-compatible bucket (OCI Object Storage)
# off = archive only, no sync
BACKUP_SYNC_MODE=local
RCLONE_REMOTE=oci-backups
RCLONE_DEST_PATH=cloudguard/db-backups

# --- OCI (Stage 2 / OpenTofu and the rclone S3 endpoint) ---------------------
OCI_REGION=eu-frankfurt-1
OCI_NAMESPACE=your_object_storage_namespace_here
OCI_TENANCY_OCID=your_tenancy_ocid_here
OCI_USER_OCID=your_user_ocid_here
OCI_FINGERPRINT=your_api_key_fingerprint_here
OCI_COMPARTMENT_OCID=your_compartment_ocid_here
OCI_BUCKET_NAME=cloudguard-db-backups

# --- Runtime -----------------------------------------------------------------
TZ=UTC
